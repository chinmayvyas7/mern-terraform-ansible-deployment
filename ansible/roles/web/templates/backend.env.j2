NODE_ENV=production
PORT=3001
MONGO_URI=mongodb://{{ mongo_application_username }}:{{ mongo_application_password | urlencode }}@{{ hostvars[groups['database'][0]].ansible_host }}:27017/{{ mongo_database_name }}?authSource={{ mongo_database_name }}
CORS_ORIGIN=http://{{ ansible_host }}
UPLOAD_DIR={{ app_upload_dir }}
MAX_UPLOAD_MB=5
TRUST_PROXY=1
